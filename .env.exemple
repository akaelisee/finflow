# ==============================================================================
# FinFlow — variables d'environnement d'exemple
# ==============================================================================
# Copie ce fichier en `.env` puis remplis les vraies valeurs :
#   cp .env.example .env
#
# Ne commit JAMAIS `.env` (déjà dans .gitignore).
# ==============================================================================

# PostgreSQL
POSTGRES_USER=finflow
POSTGRES_PASSWORD=finflow_dev_password
POSTGRES_DB=finflow

# JWT (génère un secret aléatoire pour la prod)
# En dev, tu peux garder celui-ci. En prod, utilise :
#   openssl rand -base64 32
JWT_SECRET=dev-jwt-secret-change-me-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# API
API_PORT=3000

# Front
VITE_API_URL=http://localhost:3000